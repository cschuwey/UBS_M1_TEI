        <body>
            <div1 type="acte" n="2">
            <div2 type="scene" n="5">
            <pageNum>21</pageNum>
                <head type="titre courant">Tragi Comedie</head>
            <head rend="caps">Scene V.</head>
            <stage type="setting" rend="caps">Torquatus, Omphale, Phenice.</stage>
            
                <sp who="#torquatus" toWhom="#omphale"> 
                    <speaker rend="caps">Torquatus</speaker>
                    <lg type="stanza">
                        <l ana="#decasyllabe"> 
                            Quel sujet dans ce lieu vous 
                            <app><rdg wit="ancien">ameine</rdg><rdg wit="moderne">amène</rdg></app> 
                            ?
                        </l>
                        <l ana="#alexandrin">Est-ce pitié, Madame, est-ce amour, est-ce haine?</l>
                    </lg>
                </sp>
                <sp who="#omphale" toWhom="#torquatus">
                    <speaker rend="caps">Omphale</speaker>
                    <lg type="stanza">
                        <l ana="#alexandrin">
                            C'est l'estime, 
                            <emph>Seigneur</emph>
                            , que conservent entre 
                            <rhyme label="eux">eux</rhyme>
                            .
                        </l>
                        <l ana="#alexandrin">
                            Les plus grands ennemis, quand ils sont 
                            <seg>gener<rhyme label="eux">eux</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            De l'injuste destin, la fiere 
                            <emph>
                                <app>
                                    <rdg wit="ancien">
                                        <seg>Barbar<rhyme label="ie">ie</rhyme></seg>
                                    </rdg>
                                    <rdg wit="moderne">
                                        barbarie
                                    </rdg>
                                </app>
                            </emph>
                        </l>
                        <l ana="#alexandrin">
                            Me 
                            <app><rdg wit="ancien">forçeant</rdg><rdg wit="moderne">froçant</rdg></app> 
                            malgré 
                            <app><rdg wit="ancien">moy</rdg><rdg wit="moderne">moi</rdg></app> 
                            d' 
                            <app><rdg wit="ancien">estre</rdg><rdg wit="moderne">être</rdg></app> 
                            <app><rdg wit="ancien">vostre</rdg><rdg wit="moderne">votre</rdg></app> 
                            <seg>ennem<rhyme label="ie">ie</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            <app><rdg wit="ancien">Vostre</rdg><rdg wit="moderne">Votre</rdg></app> 
                            vertu m'
                            <app><rdg wit="ancien">empesche</rdg><rdg wit="moderne">empêche</rdg></app> 
                            au moins de vous 
                            <seg>ha<rhyme label="ir">ïr</rhyme></seg>
                        </l>
                        <l ana="#alexandrin">
                            Jusqu'à vouloir vous perdre, ou jusqu'à vous 
                            <seg>trah<rhyme label="ir">ir</rhyme></seg>
                            .
                            </l>
                        <l ana="#alexandrin">
                            Apprenez donc, 
                            <emph>Seigneur</emph>
                            , que tout le Camp 
                            <seg>murm<rhyme label="ure">ure</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Et que de 
                            <app><rdg wit="ancien">vostre</rdg><rdg wit="moderne">votre</rdg></app> 
                            fils la funeste 
                            <seg>avant<rhyme label="ure">ure</rhyme></seg>
                        </l>
                        <l ana="#alexandrin">
                            Jette tant de fureur dans l'ame des 
                            <seg>sold<rhyme label="as">ats</rhyme></seg>
                        </l>
                        <l ana="#alexandrin">
                            Que vostre gloire et vous, ne s'en sauveront 
                            <seg>pas<rhyme label="as">as</rhyme></seg>
                            .
                        </l>
                    </lg>
                </sp>
                <sp who="#torquatus" toWhom="#omphale">
                    <speaker rend="caps">Torquatus</speaker>
                    <l ana="#alexandrin">
                        <app><rdg wit="ancien">Quoy</rdg><rdg wit="moderne">Quoi</rdg></app>
                        , la 
                        <seg>
                            Princesse 
                            <rs type="person" key="OMPL">Omphale</rs>
                        </seg>
                        est sensible à ma 
                        <seg>gl<rhyme label="oire">oire</rhyme></seg>
                        ?
                    </l>
                </sp>
                <sp who="#omphale" toWhom="#torquatus">
                    <speaker rend="caps">Omphale</speaker>
                    <lg type="stanza">
                        <l ana="#alexandrin">
                            Je l'
                            <app><rdg wit="ancien">ay</rdg><rdg wit="moderne">ai</rdg></app> 
                            toûjours 
                            <app><rdg wit="ancien">esté</rdg><rdg wit="moderne">été</rdg></app> 
                            ; si j'en 
                            <app><rdg wit="ancien">croy</rdg><rdg wit="moderne">crois</rdg></app>
                            ma 
                            <seg>memoire<rhyme label="oire">oire</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Et c'est par ce motif, que 
                            <app><rdg wit="ancien">j'ay</rdg><rdg wit="moderne">j'ai</rdg></app> 
                            tant 
                            <seg>comba<rhyme label="tu">tu</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Un amour dont l'effet blessoit 
                            <app><rdg wit="ancien">vostre</rdg><rdg wit="moderne">votre</rdg></app> 
                            <seg>ver<rhyme label="tu">tu</rhyme></seg>
                            .
                        </l>
                    </lg>
                </sp>
                <sp who="#torquatus" toWhom="#omphale">
                    <speaker rend="caps">Torquatus</speaker>
                    <lg type="stanza">
                        <l ana="#alexandrin">
                            Peut-estre cét orgueil a t'il une autre 
                            <seg>c<rhyme label="oz">ause</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Car de tous vos secrets, nous 
                            <app><rdg wit="ancien">sçavons</rdg><rdg wit="moderne">savons</rdg></app> 
                            quelque 
                            <seg>chose<rhyme label="oz">ose</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Mon fils vous fait pitié, vous craigrez son 
                            <seg>tré<rhyme label="pas">pas</rhyme></seg>
                            .
                        </l>
                    </lg>
                </sp>
                <sp who="#omphale" toWhom="#torquatus">
                    <speaker rend="caps">Omphale</speaker>
                    <lg type="stanza" part="Debut">
                        <l ana="#alexandrin">
                            Il est vray, je le crains ; je ne m'en 
                            <app><rdg wit="ancien">deffens</rdg><rdg wit="moderne">défends</rdg></app> 
                            <seg><rhyme label="pas">pas</rhyme></seg> 
                            ;
                        </l>
                    </lg>
                </sp>
                <note place="foot" n="1">B2</note>
                <pb/>
                <pageNum>22</pageNum>
                <head type="titre courant" rend="caps">Manlius</head>
                    <sp who="#omphale" toWhom="#torquatus">
                    <speaker rend="caps">Omphale</speaker>
                    <lg type="stanza" part="Fin">
                        <l ana="#alexandrin">
                            Si je plains d'un heros la triste 
                            <seg>desti<rhyme label="née">née</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Une pitié si noble, est d'une ame bien 
                            <seg><rhyme label="née">née</rhyme></seg> 
                            ;
                        </l>
                        <l ana="#alexandrin">
                            Et quand ce motif seul me 
                            <app><rdg wit="ancien">forceroit</rdg><rdg wit="moderne">forcerait</rdg></app> 
                            <seg>d'a<rhyme label="gir">gir</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Ce n'est pas un secret dont je 
                            <app><rdg wit="ancien">deusse</rdg><rdg wit="moderne">dusse</rdg></app> 
                            <seg>rou<rhyme label="gir">gir</rhyme></seg>
                        </l>
                        <l ana="#alexandrin">
                            Un si beau mouvement ne 
                            <app><rdg wit="ancien">seroit</rdg><rdg wit="moderne">serait</rdg></app>
                            pas un 
                            <seg>cr<rhyme label="ime">ime</rhyme></seg>
                            .
                        </l>
                    </lg>
                </sp>
                <sp who="#torquatus" toWhom="#omphale">
                    <speaker rend="caps">Torquatus</speaker>
                    <lg type="stanza">
                        <l ana="#alexandrin">
                            <app><rdg wit="ancien">Pourquoy</rdg><rdg wit="moderne">Pourquoi</rdg></app> 
                            donc le cacher, s'il est si 
                            <seg>legit<rhyme label="ime">ime</rhyme></seg> 
                            ?
                        </l>
                        <l ana="#alexandrin">
                            <app><rdg wit="ancien">Pourquoy</rdg><rdg wit="moderne">Pourquoi</rdg></app> 
                            <app><rdg wit="ancien">l'enveloper</rdg><rdg wit="moderne">l'envelopper</rdg></app> 
                            d'une feinte 
                            <seg>terr<rhyme label="eur">eur</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Et donner des 
                            <app><rdg wit="ancien">advis</rdg><rdg wit="moderne">avis</rdg></app> 
                            d'une fausse 
                            <seg>rum<rhyme label="eur">eur</rhyme></seg> 
                            ?
                        </l>
                        <l ana="#alexandrin">
                            Que ne me dites vous, je crains pour ce que 
                            <app>
                                <rdg wit="ancien">
                                    <seg>j'<rhyme label="ɛm">ayme</rhyme></seg>
                                </rdg>
                                <rdg wit="moderne">
                                    j'aime
                                </rdg>
                            </app> 
                            ?
                        </l>
                        <l ana="#alexandrin">
                            Accordez 
                            <rs type="person" key="MANL">Manlius</rs> 
                            à mon amour 
                            <seg>extr<rhyme label="ɛm">éme</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Faites 
                            <app><rdg wit="ancien">moy</rdg><rdg wit="moderne">moi</rdg></app> 
                            ce present.
                        </l>
                    </lg>
                </sp>
                <sp who="#omphale" toWhom="#torquatus">
                    <speaker rend="caps">Omphale</speaker>
                    <lg type="stanza">
                        <l ana="#alexandrin">
                            Une telle priere est un 
                            <app><rdg wit="ancien">foible</rdg><rdg wit="moderne">faible</rdg></app> 
                            secours :
                        </l>
                        <l ana="#alexandrin">
                            La mort de ce 
                            <emph>
                                <app><rdg wit="ancien">Heros</rdg><rdg wit="moderne">héros</rdg></app>
                            </emph> 
                            n'est que trop 
                            <seg>assur<rhyme label="ée">ée</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Mes 
                            <app><rdg wit="ancien">mal-heurs</rdg><rdg wit="moderne">malheurs</rdg></app>
                            , 
                            <app><rdg wit="ancien">vostre</rdg><rdg wit="moderne">votre</rdg></app>
                            amour, (et) le fort l'ont 
                            <seg>jur<rhyme label="ée">ée</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin"> 
                            Je vois bien que je fais un inutile 
                            <seg>eff<rhyme label="ort">ort</rhyme></seg>
                            .
                            </l>
                        <l ana="#alexandrin">Helas ! il perira.</l>
                    </lg>
                </sp>
                <sp who="#torquatus" toWhom="#omphale">
                    <speaker rend="caps">Torquatus</speaker>
                    <lg type="stanza">
                        <l ana="#alexandrin">
                            Moderez ce 
                            <seg>transp<rhyme label="ort">ort</rhyme></seg>
                            .
                        </l>
                        <l ana="#alexandrin">
                            Vous pourrez le sauver, si son trépas vous 
                            <seg>t<rhyme label="ouche">ouche</rhyme></seg> 
                            ;
                        </l>
                        <l ana="#alexandrin">
                            Son 
                            <app><rdg wit="ancien">arrest</rdg><rdg wit="moderne">arrêt</rdg></app> 
                            <app><rdg wit="ancien">luy</rdg><rdg wit="moderne">lui</rdg></app> 
                            sera donné par 
                            <app><rdg wit="ancien">vostre</rdg><rdg wit="moderne">votre</rdg></app>
                            <seg>b<rhyme label="ouche">ouche</rhyme></seg> 
                            :
                        </l>
                        <l ana="#alexandrin">
                            Tout mon 
                            <emph>Rival</emph> 
                            qu'il est, sa mort dépend de 
                            <seg>v<rhyme label="ous">ous</rhyme></seg>
                        </l>
                        <l ana="#alexandrin">
                            Je vous laisse y penser. 
                            <rs type="person" key="CAML">Camille</rs> 
                            vient à 
                            <seg>n<rhyme label="ous">ous</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Un pareil entretien doit finir aupres d'elle. 
                            <set>
                                <p>
                                    Il 
                                    <seg>s<rhyme label="ort">ort</rhyme></seg>
                                </p>
                            </set>
                        </l>
                    </lg>
                </sp>
                <pb/>
            </div2>
            </div1>
            <div3 type="acte" n="5">
            <div4 type="scene" n="2">
                <head rend="caps">Scene II.</head>
            <stage type="setting" rend="caps">Torquatus, Omphale, Phénice, Pison.</stage>
                <sp who="#pison" toWhom="#torquatus"> 
                    <speaker rend="caps">Pison</speaker>
                    <l><emph>Seigneur</emph>.</l>
                </sp>
                <sp who="#torquatus" toWhom="#pison"> 
                    <speaker rend="caps">Torquatus</speaker>
                    <l>
                        Qu'on aille 
                        <seg>prompté<rhyme label="ment">ment</rhyme></seg>
                    </l>
                    <l ana="#alexandrin" part="Debut">Exécuter...</l>
                </sp>
                <sp who="#omphale" toWhom="#torquatus"> 
                    <speaker rend="caps">Omphale</speaker>
                    <lg type="stanza">
                        <l part="Fin">
                            Hélas ! Différez un 
                            <seg>mo<rhyme label="ment">ment</rhyme></seg>
                        </l>
                        <l ana="#alexandrin">
                            <emph>Gardes</emph>
                            , retirez-vous, je veux...mais, quoi ! Mon 
                           <seg><rhyme label="ame">âme</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Quoi ? Voudrais-tu faire trahir 
                            <rs type="person" key="MANL">Manlius</rs> 
                            et ta 
                            <seg>fl<rhyme label="ame">amme</rhyme></seg> 
                            ?
                        </l>
                    </lg>
                </sp>
                <sp who="#torquatus" toWhom="#omphale"> 
                    <speaker rend="caps">Torquatus</speaker>
                    <l ana="#alexandrin" part="1">Que voulez-vous ?</l>
                </sp>
                <sp who="#omphale" toWhom="#torquatus"> 
                    <speaker rend="caps">Omphale</speaker>
                    <l part="2">Je veux...</l>
                </sp>
                <sp who="#torquatus" toWhom="#omphale"> 
                    <speaker rend="caps">Torquatus</speaker>
                    <l part="3">Achevez.</l>
                </sp>
                <sp who="#omphale" toWhom="#torquatus"> 
                    <speaker rend="caps">Omphale</speaker>
                    <l part="Fin">
                        Le 
                        <seg>sauv<rhyme label="er">er</rhyme></seg>
                        .
                    </l>
                </sp>
                <sp who="#torquatus" toWhom="#omphale"> 
                    <speaker rend="caps">Torquatus</speaker>
                    <l ana="#alexandrin" part="Debut">Et du reste ?</l>
                </sp>
                <sp who="#omphale" toWhom="#torquatus"> 
                    <speaker rend="caps">Omphale</speaker>
                    <l part="Fin">
                        <emph>Seigneur</emph>
                        , je voudrais y 
                        <seg>rêv<rhyme label="er">er</rhyme></seg>
                        .
                    </l>
                </sp>
                <sp who="#torquatus" toWhom="#omphale"> 
                    <speaker rend="caps">Torquatus</speaker>
                    <lg type="stanza">
                        <l ana="#alexandrin">
                            Ha ! C'est trop écouter tant de discours 
                            <seg>friv<rhyme label="oles">oles</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Je ne me repais point de ces vaines 
                            <seg>par<rhyme label="oles">oles</rhyme></seg>
                            .
                        </l>
                        <l ana="#alexandrin" part="Debut">
                            Holà, 
                            <emph>Gardes</emph>
                            .
                        </l>
                    </lg>
                </sp>
                <sp who="#omphale" toWhom="#torquatus"> 
                    <speaker rend="caps">Omphale</speaker>
                    <lg type="stanza">
                        <l part="Fin">
                            <emph>Seigneur</emph>
                            , ne précipitez 
                            <seg>r<rhyme label="ien">ien</rhyme></seg> 
                            ;
                        </l>
                        <l ana="#alexandrin">
                            Fallut-il pour son sang vous donner tout le 
                            <seg>m<rhyme label="ien">ien</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Si 
                            <rs type="person" key="MANL">Manlius</rs>  
                            le veut, j'y consens avec 
                            <seg>j<rhyme label="oie">oie</rhyme></seg> 
                            :
                        </l>
                        <l ana="#alexandrin">
                            Mais, pour m'en informer, souffrez que je le 
                            <seg>v<rhyme label="oie">oie</rhyme></seg> 
                            ;
                        </l>
                        <l ana="#alexandrin">
                            Que je puisse un moment lui parler sans 
                            <seg>tém<rhyme label="oin">oins</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Et j'atteste les Dieux d'employer tous mes 
                            <seg>s<rhyme label="oin">oins</rhyme></seg>
                        </l>
                        <l ana="#alexandrin">
                            Pour contenter, 
                            <emph>Seigneur</emph>
                            , votre pressante 
                            <seg>env<rhyme label="ie">ie</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Quand avecque ma main il vous faudrait ma 
                            <seg>v<rhyme label="ie">ie</rhyme></seg>
                            .
                            </l>
                    </lg>
                </sp>
                <sp who="#torquatus" toWhom="#omphale"> 
                    <speaker rend="caps">Torquatus</speaker>
                    <l ana="#alexandrin">
                        Je puis donc me flatter d'obtenir votre 
                        <seg>c<rhyme label="eur">oeur</rhyme></seg> 
                        :
                    </l>
                </sp>
                <sp who="#omphale" toWhom="#torquatus">  
                    <speaker rend="caps">Omphale</speaker>
                    <lg type="stanza">
                        <l ana="#alexandrin">
                            Je ne sais, mais au moins, je dirais, oui, 
                            <emph>
                                <seg>Seign<rhyme label="eur">eur</rhyme></seg>
                            </emph>
                            .
                        </l>
                        <l ana="#alexandrin">
                            Ne m'en demandez pas aujourd'hui 
                            <seg>davant<rhyme label="age">age</rhyme></seg> 
                            :
                        </l>
                        <l ana="#alexandrin">
                            Il n'appartient qu'au temps d'achever cet 
                            <seg>ouvr<rhyme label="age">age</rhyme></seg>
                            .
                        </l>
                    </lg>
                </sp>
                <sp who="#torquatus" toWhom="#omphale"> 
                    <speaker rend="caps">Torquatus</speaker>
                    <l ana="#alexandrin">
                        Ha ! 
                        <emph>Princesse</emph>
                        , mon coeur à vos ordres soumis...
                    </l>
                </sp>
                <sp who="#omphale" toWhom="#torquatus"> 
                    <speaker rend="caps">Omphale</speaker>
                    <lg type="stanza">
                        <l ana="#alexandrin">
                            Et de grâce, 
                            <emph>Seigneur</emph>
                            , songeons à votre fils ;
                        </l>
                        <l ana="#alexandrin">
                            Avec plus de loisir nous parlerons du 
                            <seg>r<rhyme label="este">este</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin">
                            Révoquez seulement un Arrêt si 
                            <seg>fun<rhyme label="este">este</rhyme></seg>
                            .
                        </l>
                        <l ana="#alexandrin">
                            Qu'on cherche Manlius, qu'on le fasse 
                            <seg>ven<rhyme label="ir">ir</rhyme></seg> 
                            :
                        </l>
                        <l ana="#alexandrin">
                            Nous aurons trop de temps pour nous 
                            <seg>entreten<rhyme label="ir">ir</rhyme></seg>
                            .
                        </l>
                    </lg>
                </sp>
                <sp who="#torquatus" toWhom="#omphale"> 
                    <speaker rend="caps">Torquatus</speaker>
                    <lg type="stanza">
                        <l ana="#alexandrin">
                            Holà, quelqu'un, courez dans la tente 
                            <seg>proch<rhyme label="ɛn">aine</rhyme></seg>
                        </l>
                        <l ana="#alexandrin">
                            Où l'on garde mon fils, dire qu'on me 
                            <seg>l'am<rhyme label="ɛn">ène</rhyme></seg>
                            .
                        </l>
                        <l ana="#alexandrin">
                            <emph>Princesse</emph>
                            , s'il consent aux plus doux de mes 
                            <seg>v<rhyme label="eux">oeux</rhyme></seg>
                            ,
                        </l>
                        <l ana="#alexandrin" part="Debut">Mon bonheur...</l>
                    </lg>
                </sp>
                <sp who="#omphale" toWhom="#torquatus"> 
                    <speaker rend="caps">Omphale</speaker>
                    <lg type="stanza">
                        <l part="Fin">Hé, 
                            <emph>Seigneur</emph>
                            , se peut-on croire 
                            <seg>heur<rhyme label="eux">eux</rhyme></seg>
                            ,
