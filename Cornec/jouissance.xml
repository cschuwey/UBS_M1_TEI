		</fileDesc>
	</teiHeader>
	<text>
		<body>
			<head>Jouissance</head>
			<lg type="quatrain" rhyme="abba">
				<l>
					<app><rdg wit="ancien">Aujourd'huy</rdg><rdg wit="moderne">Aujourd'hui</rdg></app>
					dans tes bras
					<caesura />
					<app><rdg wit="ancien">i'ay</rdg><rdg wit="moderne">j'ai</rdg></app> 
                    demeuré
					<app><rdg wit="ancien">pafmée</rdg><rdg wit="moderne"><seg>pâ<rhyme label="a">mée</rhyme></seg></rdg></app>
					,
				</l>
				<l>
					<app><rdg wit="ancien">Aujourd'huy</rdg><rdg wit="moderne">Aujourd'hui</rdg></app>
                	, cher
					<app><rdg wit="ancien">Tirfis</rdg><rdg wit="moderne"><name>Tirsis</name></rdg></app> 
                    <caesura /> 
                    , ton 
                    <app><rdg wit="ancien">amoureufe</rdg><rdg wit="moderne">amoureuse</rdg></app>
					<seg>ard<rhyme label="b">eur</rhyme></seg>
				</l>
				<l>
                	Triomphe impunément
					<caesura />
					de toute ma
					<seg>pud<rhyme label="b">eur</rhyme></seg>
                </l>
				<l>
					Et 
                	<app><rdg wit="ancien">ie</rdg><rdg wit="moderne">je</rdg></app> 
                	cède aux 
                	<app><rdg wit="ancien">tranfports</rdg><rdg wit="moderne">transports</rdg></app>
					<caesura />
					dont mon 
                    <app><rdg wit="ancien">ame</rdg><rdg wit="moderne">âme</rdg></app> 
                    <app><rdg wit="ancien">eft</rdg><rdg wit="moderne">est</rdg></app>
					<seg>char<rhyme label="a">mée</rhyme></seg>
					.
				</l>
			</lg>
			<lg type="quatrain" rhyme="abba">
				<l>
                	Ta 
                	<app><rdg wit="ancien">flame</rdg><rdg wit="moderne">flamme</rdg></app> 
                	et ton 
                	<app><rdg wit="ancien">refpect</rdg><rdg wit="moderne">respect</rdg></app>
					<caesura />
					m'ont enfin
					<app><rdg wit="ancien">defarmée</rdg><rdg wit="moderne"><seg>désar<rhyme label="a">mée</rhyme></seg></rdg></app>
					;
				</l>
				<l>
					Dans nos 
               		<app><rdg wit="ancien">embraffemens</rdg><rdg wit="moderne">embrassements</rdg></app>
					,
					<caesura />
					<app><rdg wit="ancien">ie</rdg><rdg wit="moderne">je</rdg></app> 
                    mets tout mon
					<seg>bonh<rhyme label="b">eur</rhyme></seg>
				</l>
				<l>
					Et 
                	<app><rdg wit="ancien">ie</rdg><rdg wit="moderne">je</rdg></app> 
                	ne 
                	<app><rdg wit="ancien">connois</rdg><rdg wit="moderne">connais</rdg></app> 
                	plus
					<caesura />
					de vertu 
                    <app><rdg wit="ancien">ny</rdg><rdg wit="moderne">ni</rdg></app>
					<seg>d'honn<rhyme label="b">eur</rhyme></seg>
                </l>
				<l>
					Puisque 
                	<app><rdg wit="ancien">i'ayme</rdg><rdg wit="moderne">j'aime</rdg></app>
					<name>Tirsis</name>
					<caesura />
					et que 
                    <app><rdg wit="ancien">i'en</rdg><rdg wit="moderne">j'en</rdg></app> 
                    <app><rdg wit="ancien">fuis</rdg><rdg wit="moderne">suis</rdg></app>
					<seg>ai<rhyme label="a">mée</rhyme></seg>
					. 
                </l>
			</lg>
			<lg type="tercet" rhyme="ccd">
				<l>
                	O vous, 
                	<app><rdg wit="ancien">foibles</rdg><rdg wit="moderne">faibles</rdg></app> 
                	<app><rdg wit="ancien">efprits</rdg><rdg wit="moderne">esprits</rdg></app>
					,
					<caesura />
					qui ne 
                    <app><rdg wit="ancien">connoiffez</rdg><rdg wit="moderne">connaissez</rdg></app>
					<seg>p<rhyme label="c">as</rhyme></seg>
				</l>
				<l>
                	Les 
                	<app><rdg wit="ancien">plaifirs</rdg><rdg wit="moderne">plaisirs</rdg></app> 
                	les plus doux
					<caesura />
					que l'on 
                    <app><rdg wit="ancien">goufte</rdg><rdg wit="moderne">goûte</rdg></app>
					<app><rdg wit="ancien">icy bas</rdg><rdg wit="moderne"><seg>ici-b<rhyme label="c">as</rhyme></seg></rdg></app>
					,
                </l>
				<l>
                	Apprenez les 
                	<app><rdg wit="ancien">tranfports</rdg><rdg wit="moderne">transports</rdg></app>
					<caesura />
					dont mon 
                    <app><rdg wit="ancien">ame</rdg><rdg wit="moderne">âme</rdg></app> 
                    <app><rdg wit="ancien">eft</rdg><rdg wit="moderne">est</rdg></app>
					<app><rdg wit="ancien">rauie</rdg><rdg wit="moderne"><seg>ra<rhyme label="d">vie</rhyme></seg></rdg></app>
					!
                </l>
			</lg>
			<lg type="tercet" rhyme="eed">
				<l>
               		Une douce langueur
					<caesura />
					<app><rdg wit="ancien">mofte</rdg><rdg wit="moderne">m'ôte</rdg></app> 
                    le
					<app><rdg wit="ancien">fentiment</rdg><rdg wit="moderne"><seg>senti<rhyme label="e">ment</rhyme></seg></rdg></app>
					,
                </l>
				<l>
                	<app><rdg wit="ancien">Ie</rdg><rdg wit="moderne">Je</rdg></app>
                 	meurs entre les bras
					<caesura />
					de mon 
                    <app><rdg wit="ancien">fidelle</rdg><rdg wit="moderne">fidèle</rdg></app>
					<emph><seg>A<rhyme label="e">mant</rhyme></seg></emph>
					,
				</l>
				<l>
                	Et 
                	<app><rdg wit="ancien">c'eft</rdg><rdg wit="moderne">c'est</rdg></app> 
                	dans cette mort
					<caesura />
					que 
                    <app><rdg wit="ancien">ie</rdg><rdg wit="moderne">je</rdg></app> 
                    <app><rdg wit="ancien">trouue</rdg><rdg wit="moderne">trouve</rdg></app> 
                    la
					<seg><rhyme label="d">vie</rhyme></seg>
					.
				</l>
			</lg>
		</body>
	</text>
</TEI>
