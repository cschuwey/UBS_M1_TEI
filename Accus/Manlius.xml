       <castList>
           <castItem>
        <role xml:id="torquatus">Torquatus,</role><roleDesc rend="italic">Consule Romain.</roleDesc>
           </castItem>
           <castItem>
               <role xml:id="manilus">Manlius,</role><roleDesc rend="italic">Fils du Consule.</roleDesc>
           </castItem>
           <castItem>
               <role xml:id="camille">Camille,</role><roleDesc rend="italic">Veuve de Decius.</roleDesc>
           </castItem>
           <castItem> 
               <role xml:id="omphale">Omphale</role><roleDesc rend="italic">Princesse d'Empire captive des Ro-
               mains.</roleDesc>
           </castItem>
           <castItem>
               <role xml:id="junius">Junius,</role><roleDesc rend="italic">Amy de Torquatus.</roleDesc>
           </castItem>
           <castItem>
               <role xml:id="phenice">Phenice,</role><roleDesc rend="italic">Suivante d'Omphale.</roleDesc>
           </castItem>
